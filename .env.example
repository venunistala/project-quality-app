# apps/api
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Must be kept in sync by hand with the POSTGRES_* vars below - docker-compose
# uses discrete vars, the api/drizzle-kit/seed scripts use one connection URL.
DATABASE_URL=postgresql://quality_lab:quality_lab@localhost:5432/quality_lab

# docker-compose postgres
POSTGRES_USER=quality_lab
POSTGRES_PASSWORD=quality_lab
POSTGRES_DB=quality_lab
POSTGRES_PORT=5432
